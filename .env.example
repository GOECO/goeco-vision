# Sao chép file này thành .env và điền thông tin thật

# PostgreSQL từ Railway hoặc Render
# Railway:  postgresql+asyncpg://postgres:<password>@<host>.railway.app:5432/railway
# Render:   postgresql+asyncpg://<user>:<password>@<host>.render.com:5432/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/goeco_vision

# Bật log SQL khi debug
DEBUG=false

# JWT
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# YOLO (không cần thay đổi — model tự download lần đầu)
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5

# AI endpoint (để trống nếu dùng YOLO local)
AI_MODEL_ENDPOINT=
AI_MODEL_API_KEY=

# Camera stream (RTSP URL mẫu)
CAMERA_STREAM_BASE_URL=rtsp://camera.goeco.local
